# ==========================================
# Finora Web — Shared environment template
# ==========================================
# Local-development template only; do not use these settings in production.
# Keep production secrets out of source control.

NODE_ENV=development
PORT=3000

# API connection mode
# Values: mock | real
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_MODE=real
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Optional app metadata / analytics
NEXT_PUBLIC_APP_NAME=Finora Web
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_DEBUG_LOGS=false

# Browser CORS / local dev
NEXT_PUBLIC_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
