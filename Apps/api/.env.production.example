# ==========================================
# Finora API — Production environment
# ==========================================
NODE_ENV=production
PORT=3001
CORS_ORIGINS=https://app.finora.example.com,https://www.finora.example.com
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/finora
ENABLE_PRISMA=true
ENABLE_SWAGGER=false
# Required in production: the app must be behind a proxy that sets X-Forwarded-For.
TRUST_PROXY=true
LOG_LEVEL=info

# Authentication uses opaque bearer session tokens (SHA-256 hashed at rest,
# 30-day expiry, revoked on logout/refresh). There is no JWT and therefore no
# JWT/session signing secret to configure.
