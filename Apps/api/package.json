{
  "name": "@finora/api",
  "private": true,
  "scripts": {
    "build": "nest build",
    "db:generate": "node scripts/generate-prisma-client.cjs",
    "db:validate": "prisma validate --schema ../../prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema ../../prisma/schema.prisma",
    "start": "node scripts/start-local.cjs",
    "stop": "node scripts/stop-local.cjs",
    "test:process": "node --test scripts/start-local.test.cjs",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand && node --test scripts/start-local.test.cjs",
    "test:production": "jest --runInBand test/production-e2e.spec.ts"
  },
  "dependencies": {
    "@finora/contracts": "workspace:*",
    "@finora/domain": "workspace:*",
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/swagger": "^8.1.1",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.22",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
