# ==========================================
# Finora API — Development environment
# ==========================================
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002,http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006
DATABASE_URL=postgresql://finora:finora@localhost:5432/finora
ENABLE_PRISMA=false
ENABLE_SWAGGER=true
TRUST_PROXY=false
LOG_LEVEL=debug

# Authentication uses opaque bearer session tokens (SHA-256 hashed at rest,
# 30-day expiry, revoked on logout/refresh). There is no JWT and therefore no
# JWT/session signing secret to configure.
