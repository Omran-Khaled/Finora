# ==========================================
# Finora Mobile — Shared environment template
# ==========================================
# Copy this file to `.env.local` or use Expo env files.
# Keep production secrets out of source control.

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_NAME=Finora
EXPO_PUBLIC_USE_REAL_API=0
# For a physical device on the same LAN, use the computer's LAN IP instead:
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3001
# For access outside the LAN, use a deployed HTTPS API or a temporary HTTPS tunnel.
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_API_BASE_PATH=/api/v1
EXPO_PUBLIC_ENABLE_ANALYTICS=false
EXPO_PUBLIC_ENABLE_DEBUG_LOGS=true
